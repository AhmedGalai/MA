FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# ---- system deps (build + runtime) ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential cmake pkg-config git \
    libssl-dev libplist-dev libavahi-compat-libdnssd-dev \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-libav \
    gstreamer1.0-alsa \
    gstreamer1.0-x \
    avahi-daemon avahi-utils dbus \
    python3 python3-pip python3-opencv \
    && rm -rf /var/lib/apt/lists/*

# ---- build uxplay from source (antimof) ----
WORKDIR /build
RUN git clone https://github.com/antimof/UxPlay.git && \
    cd UxPlay && \
    mkdir -p build && cd build && \
    cmake .. && \
    make -j"$(nproc)" && \
    make install && \
    ldconfig

# ---- python deps ----
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip3 install --no-cache-dir -r /app/requirements.txt

# ---- app ----
COPY forward_frames.py /app/forward_frames.py
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh && sed -i 's/\r$//' /app/entrypoint.sh /app/forward_frames.py

# AirPlay ports (mainly relevant for bridge-mode / WSL compose)
EXPOSE 7000/tcp 7001/tcp 7100/tcp 6000/udp 6001/udp 5353/udp

ENTRYPOINT ["/app/entrypoint.sh"]
